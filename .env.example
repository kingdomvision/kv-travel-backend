# Backend application env — Docker services by default; swap URLs for managed providers

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Auth — in production each secret MUST be >= 32 random characters
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-32b
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Refresh cookie (httpOnly). COOKIE_SECURE=true required behind HTTPS / production.
REFRESH_COOKIE_NAME=kv_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# PostgreSQL (Docker) — e.g. Neon/RDS: postgresql://user:pass@host:5432/db?sslmode=require
DATABASE_URL=postgresql://kvtravel:kvtravel@localhost:5433/kvtravel?schema=public

# Redis (Docker) — e.g. Upstash/ElastiCache: rediss://default:TOKEN@host:6379
REDIS_URL=redis://localhost:6379

# Object storage — MinIO locally; set STORAGE_PROVIDER=s3 and omit S3_ENDPOINT for AWS
STORAGE_PROVIDER=minio
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=kv-travel
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_CONTENT_TYPES=application/pdf,image/jpeg,image/png,image/webp,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# CORS (admin :4200, tenant :4201)
CORS_ORIGINS=http://localhost:4200,http://localhost:4201

# Seed credentials (dev/staging only — never used when NODE_ENV=production)
SEED_PLATFORM_EMAIL=admin@kvtravel.local
SEED_PLATFORM_PASSWORD=CHANGE_ME_IN_DEV
SEED_TENANT_EMAIL=agent@acme.local
SEED_TENANT_PASSWORD=CHANGE_ME_IN_DEV
